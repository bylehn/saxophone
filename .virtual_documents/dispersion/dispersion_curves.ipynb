    F, D, V, forbidden_states = getModes(C,k, M, kappa, w, dw)
    N_modes = len(modes)
    Nrows = 4
    Ncols = np.ceil(N_modes / Nrows).astype(int)
    
    # Plotting modes with colored nodes and arrows
    fig1 = plt.figure(figsize=(10, 10))
    gs1 = gridspec.GridSpec(Ncols, Nrows, figure=fig1, wspace=0.2, hspace=0.2)
    for i, mode in enumerate(modes):
        ax = plt.subplot(gs1[i])
        ax.set_facecolor('k')
        X2=X+phase*np.stack((V[0:2*N:2,mode],V[1:2*N:2,mode])).T
        pos2 = dict(zip(range(G.number_of_nodes()), X2))
        delta_E=C.T@V
        
        vlim=np.max(np.abs(delta_E[:,mode]))
        EC=phase*delta_E[:,mode]
        
        nx.draw_networkx(G,pos2,node_size=20, ax=ax, with_labels = 0,node_color='w',width=2,edge_color=EC,edge_cmap=plt.cm.bwr,edge_vmin=-vlim, edge_vmax=vlim)
        plt.title('$\omega =$'+ str(np.round(np.sqrt(np.abs(D[mode])),3)))
        plotlimits = [min(X_.min(), Y_.min()) - 2, max(X_.max(), Y_.max()) + 2]
        plt.xlim(plotlimits)
        plt.ylim(plotlimits)
    
    return


